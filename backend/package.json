{
  "name": "bookmarks-manager-backend",
  "version": "1.0.0",
  "description": "Node.js backend for Bookmarks Manager",
  "main": "server.js",
  "engines": {
    "node": ">=20.17.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd ../frontend && npm install && npm run build",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "axios": "^1.19.0",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
